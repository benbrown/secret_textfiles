<!DOCTYPE html>
<html>
  <head>
    <title>{{#if meta.title}}{{meta.title}}{{else}}{{title}}{{/if}}</title>
    <link rel="stylesheet" href="{{rootUrl}}/css/main.css" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed for {{title}}" href="{{rootUrl}}/feed" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Social Media Meta Tags -->
    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="{{title}}" />
    <meta property="og:type" content="{{#if meta.type}}{{meta.type}}{{else}}website{{/if}}" />
    <meta property="og:url" content="{{#if meta.url}}{{meta.url}}{{else}}{{rootUrl}}/{{/if}}" />
    <meta property="og:title" content="{{#if meta.title}}{{meta.title}}{{else}}{{title}}{{/if}}" />
    {{#if meta.description}}
    <meta property="og:description" content="{{meta.description}}" />
    {{/if}}
    {{#if meta.image}}
    <meta property="og:image" content="{{meta.image}}" />
    {{/if}}

    <!-- Twitter -->
    <meta name="twitter:card" content="{{#if meta.image}}summary_large_image{{else}}summary{{/if}}" />
    <meta name="twitter:url" content="{{#if meta.url}}{{meta.url}}{{else}}{{rootUrl}}/{{/if}}" />
    <meta name="twitter:title" content="{{#if meta.title}}{{meta.title}}{{else}}{{title}}{{/if}}" />
    {{#if meta.description}}
    <meta name="twitter:description" content="{{meta.description}}" />
    {{/if}}
    {{#if meta.image}}
    <meta name="twitter:image" content="{{meta.image}}" />
    {{/if}}
        
  </head>
  <body{{#if streamAside}} class="stream-aside-body"{{/if}}>
    {{#if streamAside}}
    <div class="stream-page">
      <div id="main" class="stream-main-col">
        <header>
          <h1><a href="{{rootUrl}}/">{{title}}</a></h1>
        </header>

        {{{body}}}
      </div>

      <aside class="stream-aside" aria-label="Site">
        <nav class="stream-aside-nav">
          <a href="https://benbrown.com">Homepage</a>
          <a href="{{rootUrl}}/">Blog</a>
          <a href="{{rootUrl}}/archive">Archive</a>
        </nav>
        {{#if siteDescription}}
        <p class="stream-aside-desc">{{siteDescription}}</p>
        {{/if}}
        <p><a href="{{rootUrl}}/feed">RSS feed</a></p>
        <p><a href="https://masto.hackers.town/@benbrown">Socials</a></p>
      </aside>
    </div>
    {{else}}
    <div id="main">
      <header>
        <h1><a href="{{rootUrl}}/">{{title}}</a></h1>
      </header>

      {{{body}}}

    </div>
    {{/if}}
  </body>
</html>
