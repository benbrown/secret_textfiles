{{#if newerUrl}}
<p>&larr; <a href="{{newerUrl}}">Newer posts</a></p>
{{/if}}

{{#each days}}
  <h4>└ <a href="{{rootUrl}}/stream/{{key}}">{{key}}</a> / </h4>
  {{#each posts}}
    <article>
      <h4><a href="{{../../rootUrl}}/read/{{id}}">{{metadata.title}}</a></h4>
      <div class="post-content">
      {{{rendered}}}
      </div>
    </article>
  {{/each}}
{{/each}}

{{#if olderUrl}}
<p>&rarr; <a href="{{olderUrl}}">Older posts</a></p>
{{/if}}

